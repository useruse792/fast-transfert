/* =====================================================
   RECHERCHE TRANSFERT
===================================================== */

async function findTransfer(){

    const code =
        document
        .getElementById("transferCodeInput")
        .value
        .trim()
        .toUpperCase();

    const result =
        document.getElementById("downloadResult");

    if(!code){

        result.innerHTML =
            "⚠️ Entre un code.";

        return;
    }

    result.innerHTML =
        "Recherche...";

    const {
        data:transfer,
        error
    } =
    await supabaseClient
    .from("transfers")
    .select(`
        id,
        file_id,
        transfer_code,
        expires_at,
        max_downloads,
        download_count,
        files (
            file_name,
            storage_path,
            file_size
        )
    `)
    .eq("transfer_code",code)
    .maybeSingle();

    if(error){

        console.error(error);

        result.innerHTML =
            "❌ Erreur de recherche.";

        return;
    }

    if(!transfer){

        result.innerHTML =
            "❌ Code introuvable.";

        return;
    }

    if(
        transfer.expires_at &&
        new Date(transfer.expires_at) < new Date()
    ){

        result.innerHTML =
            "⏰ Ce transfert a expiré.";

        return;
    }

    if(
        transfer.max_downloads !== null &&
        transfer.download_count >= transfer.max_downloads
    ){

        result.innerHTML =
            "🚫 Nombre maximum de téléchargements atteint.";

        return;
    }

    const file =
        transfer.files;

    result.innerHTML = `
        <div class="code-box">

            <div style="font-size:28px">
                📦
            </div>

            <strong>
                ${escapeHTML(file.file_name)}
            </strong>

            <div style="
                color:#718096;
                margin:8px 0 15px;
            ">
                ${formatSize(file.file_size)}
            </div>

            <button
                class="copy-btn"
                onclick="downloadTransfer(
                    '${transfer.id}',
                    '${escapeJS(file.storage_path)}'
                )"
            >
                ⬇️ Télécharger
            </button>

        </div>
    `;
}


/* =====================================================
   DOWNLOAD TRANSFERT
===================================================== */

async function downloadTransfer(
    transferId,
    storagePath
){

    const {
        data,
        error
    } =
    await supabaseClient
    .storage
    .from("fastdrop")
    .createSignedUrl(
        storagePath,
        300
    );

    if(error){

        alert(
            "Impossible de générer le téléchargement."
        );

        return;
    }

    await supabaseClient
    .from("download_logs")
    .insert({
        transfer_id:transferId
    });

    /*
       Mise à jour simple du compteur.
       Pour une sécurité maximale, cette partie
       sera déplacée dans une Edge Function.
    */

    const {
        data:transfer
    } =
    await supabaseClient
    .from("transfers")
    .select("download_count")
    .eq("id",transferId)
    .single();

    if(transfer){

        await supabaseClient
        .from("transfers")
        .update({
            download_count:
                Number(transfer.download_count || 0) + 1
        })
        .eq("id",transferId);
    }

    window.open(
        data.signedUrl,
        "_blank"
    );
}


