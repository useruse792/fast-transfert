<script>

/* =====================================================
   CONFIGURATION SUPABASE
===================================================== */

const SUPABASE_URL =
    "TON_SUPABASE_URL";

const SUPABASE_ANON_KEY =
    "TA_CLE_ANON";

const supabaseClient =
    supabase.createClient(
        SUPABASE_URL,
        SUPABASE_ANON_KEY
    );


/* =====================================================
   ÉTAT
===================================================== */

let currentUser = null;


/* =====================================================
   ELEMENTS
===================================================== */

const authPage =
    document.getElementById("authPage");

const app =
    document.getElementById("app");

const authMessage =
    document.getElementById("authMessage");


/* =====================================================
   AUTH UI
===================================================== */

function showLogin(){

    document
        .getElementById("loginForm")
        .classList.remove("hidden");

    document
        .getElementById("registerForm")
        .classList.add("hidden");

    document
        .getElementById("loginTab")
        .classList.add("active");

    document
        .getElementById("registerTab")
        .classList.remove("active");

    authMessage.textContent = "";
}


function showRegister(){

    document
        .getElementById("loginForm")
        .classList.add("hidden");

    document
        .getElementById("registerForm")
        .classList.remove("hidden");

    document
        .getElementById("loginTab")
        .classList.remove("active");

    document
        .getElementById("registerTab")
        .classList.add("active");

    authMessage.textContent = "";
}


/* =====================================================
   INSCRIPTION
===================================================== */

async function register(){

    const username =
        document
        .getElementById("registerUsername")
        .value.trim();

    const email =
        document
        .getElementById("registerEmail")
        .value.trim();

    const password =
        document
        .getElementById("registerPassword")
        .value;

    if(!username || !email || !password){

        authMessage.textContent =
            "⚠️ Remplis tous les champs.";

        return;
    }

    if(password.length < 6){

        authMessage.textContent =
            "⚠️ Le mot de passe doit contenir au moins 6 caractères.";

        return;
    }

    authMessage.textContent =
        "Création du compte...";

    const {
        data,
        error
    } =
    await supabaseClient.auth.signUp({
        email,
        password,
        options:{
            data:{
                username
            }
        }
    });

    if(error){

        authMessage.textContent =
            "❌ " + error.message;

        return;
    }

    if(data.user){

        const {
            error: profileError
        } =
        await supabaseClient
        .from("profiles")
        .insert({
            id:data.user.id,
            username:username
        });

        if(profileError){

            console.error(profileError);

            authMessage.textContent =
                "⚠️ Compte créé, mais le profil n'a pas pu être créé.";

            return;
        }
    }

    authMessage.style.color = "#68e0a2";

    authMessage.textContent =
        "✅ Compte créé ! Vérifie ton e-mail si nécessaire.";

}


/* =====================================================
   CONNEXION
===================================================== */

async function login(){

    const email =
        document
        .getElementById("loginEmail")
        .value.trim();

    const password =
        document
        .getElementById("loginPassword")
        .value;

    if(!email || !password){

        authMessage.textContent =
            "⚠️ Remplis tous les champs.";

        return;
    }

    authMessage.style.color = "#ff7888";

    authMessage.textContent =
        "Connexion...";

    const {
        data,
        error
    } =
    await supabaseClient.auth.signInWithPassword({
        email,
        password
    });

    if(error){

        authMessage.textContent =
            "❌ " + error.message;

        return;
    }

    currentUser = data.user;

    await openApp();
}


/* =====================================================
   LOGOUT
===================================================== */

async function logout(){

    await supabaseClient.auth.signOut();

    currentUser = null;

    app.classList.add("hidden");
    authPage.classList.remove("hidden");

    showLogin();
}


/* =====================================================
   OUVRIR APPLICATION
===================================================== */

async function openApp(){

    authPage.classList.add("hidden");
    app.classList.remove("hidden");

    const {
        data:profile
    } =
    await supabaseClient
    .from("profiles")
    .select("username")
    .eq("id",currentUser.id)
    .maybeSingle();

    const username =
        profile?.username ||
        currentUser.user_metadata?.username ||
        currentUser.email;

    document
        .getElementById("headerUsername")
        .textContent =
        "👤 " + username;

    await loadFiles();
}


/* =====================================================
   FORMAT TAILLE
===================================================== */

function formatSize(bytes){

    if(bytes < 1024)
        return bytes + " B";

    if(bytes < 1024*1024)
        return (bytes/1024).toFixed(1) + " KB";

    if(bytes < 1024*1024*1024)
        return (bytes/1024/1024).toFixed(1) + " MB";

    return (bytes/1024/1024/1024).toFixed(2) + " GB";
}


/* =====================================================
   UPLOAD
===================================================== */

async function uploadFiles(files){

    if(!currentUser) return;

    for(const file of files){

        await uploadSingleFile(file);
    }

    await loadFiles();
}


async function uploadSingleFile(file){

    const uploads =
        document.getElementById("uploads");

    const item =
        document.createElement("div");

    item.className = "upload-item";

    item.innerHTML = `
        <div class="upload-top">
            <span class="file-name">
                📄 ${escapeHTML(file.name)}
            </span>
            <span class="percent">0%</span>
        </div>

        <div class="progress">
            <div class="progress-bar"></div>
        </div>
    `;

    uploads.prepend(item);

    const bar =
        item.querySelector(".progress-bar");

    const percent =
        item.querySelector(".percent");

    /*
       Supabase Storage utilise ici son upload
       standard. Pour les très gros fichiers,
       nous pourrons ensuite remplacer cette
       partie par un upload resumable.
    */

    const safeName =
        file.name
        .replace(/[^\w.\-() ]/g,"_");

    const path =
        currentUser.id +
        "/" +
        Date.now() +
        "_" +
        safeName;

    const {
        error
    } =
    await supabaseClient
    .storage
    .from("fastdrop")
    .upload(
        path,
        file,
        {
            cacheControl:"3600",
            upsert:false
        }
    );

    if(error){

        console.error(error);

        item.innerHTML =
            `<span style="color:#ff7888">
                ❌ ${escapeHTML(error.message)}
            </span>`;

        return;
    }

    bar.style.width = "100%";
    percent.textContent = "100%";

    const {
        error:dbError
    } =
    await supabaseClient
    .from("files")
    .insert({
        owner_id:currentUser.id,
        file_name:file.name,
        storage_path:path,
        file_size:file.size,
        mime_type:file.type || "application/octet-stream"
    });

    if(dbError){

        console.error(dbError);

        item.innerHTML =
            `<span style="color:#ff7888">
                ❌ Fichier envoyé mais erreur base de données.
            </span>`;

        return;
    }

    item.innerHTML =
        `<span style="color:#68e0a2">
            ✅ ${escapeHTML(file.name)} envoyé !
        </span>`;

    setTimeout(()=>{
        item.remove();
    },3000);
}


/* =====================================================
   CHARGER FICHIERS
===================================================== */

async function loadFiles(){

    const list =
        document.getElementById("fileList");

    list.innerHTML =
        "Chargement...";

    const {
        data,
        error
    } =
    await supabaseClient
    .from("files")
    .select("*")
    .eq("owner_id",currentUser.id)
    .order("created_at",{ascending:false});

    if(error){

        list.innerHTML =
            "❌ Impossible de charger les fichiers.";

        console.error(error);

        return;
    }

    if(!data.length){

        list.innerHTML =
            `<div style="color:#718096;text-align:center;padding:20px">
                Aucun fichier pour le moment.
            </div>`;

        updateStats([]);

        return;
    }

    list.innerHTML = "";

    data.forEach(file=>{

        const element =
            document.createElement("div");

        element.className = "file";

        element.innerHTML = `
            <div class="file-icon">
                ${getFileIcon(file.file_name)}
            </div>

            <div class="file-info">
                <div class="file-title">
                    ${escapeHTML(file.file_name)}
                </div>

                <div class="file-meta">
                    ${formatSize(file.file_size)}
                    •
                    ${new Date(file.created_at).toLocaleString("fr-FR")}
                </div>
            </div>

            <div class="file-actions">

                <button
                    class="small-btn"
                    onclick="downloadOwnFile('${file.id}')"
                >
                    ↓
                </button>

                <button
                    class="small-btn"
                    onclick="createTransfer('${file.id}')"
                >
                    🔗
                </button>

                <button
                    class="small-btn delete-btn"
                    onclick="deleteFile('${file.id}','${escapeJS(file.storage_path)}')"
                >
                    🗑
                </button>

            </div>
        `;

        list.appendChild(element);

    });

    updateStats(data);
}


/* =====================================================
   STATS
===================================================== */

function updateStats(files){

    document
        .getElementById("fileCount")
        .textContent =
        files.length;

    const total =
        files.reduce(
            (sum,file)=>sum + Number(file.file_size || 0),
            0
        );

    document
        .getElementById("totalSize")
        .textContent =
        formatSize(total);
}


/* =====================================================
   DOWNLOAD PERSONNEL
===================================================== */

async function downloadOwnFile(id){

    const {
        data:file,
        error
    } =
    await supabaseClient
    .from("files")
    .select("*")
    .eq("id",id)
    .eq("owner_id",currentUser.id)
    .single();

    if(error){

        alert("Impossible de trouver le fichier.");
        return;
    }

    const {
        data,
        error:downloadError
    } =
    await supabaseClient
    .storage
    .from("fastdrop")
    .createSignedUrl(
        file.storage_path,
        300
    );

    if(downloadError){

        alert("Erreur lors de la création du lien.");
        return;
    }

    window.open(
        data.signedUrl,
        "_blank"
    );
}


/* =====================================================
   SUPPRESSION
===================================================== */

async function deleteFile(id,path){

    if(!confirm(
        "Supprimer définitivement ce fichier ?"
    )) return;

    const {
        error:storageError
    } =
    await supabaseClient
    .storage
    .from("fastdrop")
    .remove([path]);

    if(storageError){

        console.error(storageError);
    }

    const {
        error
    } =
    await supabaseClient
    .from("files")
    .delete()
    .eq("id",id)
    .eq("owner_id",currentUser.id);

    if(error){

        alert(
            "Erreur : " + error.message
        );

        return;
    }

    await loadFiles();
}


/* =====================================================
   CODE DE TRANSFERT
===================================================== */

function generateCode(){

    const chars =
        "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

    let code = "";

    for(let i=0;i<8;i++){

        code +=
            chars[
                Math.floor(
                    Math.random()*chars.length
                )
            ];
    }

    return code;
}


async function createTransfer(fileId){

    const code =
        generateCode();

    const expires =
        new Date(
            Date.now() + 24*60*60*1000
        ).toISOString();

    const {
        error
    } =
    await supabaseClient
    .from("transfers")
    .insert({
        file_id:fileId,
        owner_id:currentUser.id,
        transfer_code:code,
        expires_at:expires,
        max_downloads:10
    });

    if(error){

        alert(
            "Impossible de créer le transfert : " +
            error.message
        );

        return;
    }

    showTransferCode(code);
}


function showTransferCode(code){

    const result =
        document.getElementById("downloadResult");

    result.innerHTML = `
        <div class="code-box">

